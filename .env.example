# --- Supabase (required for live data, admin, forms) ---
# Project URL + anon key are safe in the browser (they're public keys).
NEXT_PUBLIC_SUPABASE_URL=https://kajolpuntjurjrozovnq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imtham9scHVudGp1cmpyb3pvdm5xIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY0NzI4NTgsImV4cCI6MjEwMjA0ODg1OH0.t4CkH__iLX4k1IyUWjRuwHWYNfsjJc_bfEg79x-pf-E

# Service-role key — SERVER-SIDE ONLY. Never import this into client
# code; it is used exclusively by server actions / data layer.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imtham9scHVudGp1cmpyb3pvdm5xIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NjQ3Mjg1OCwiZXhwIjoyMTAyMDQ4ODU4fQ.MvkWaOZAFLIT6LsOMnd0yIJmpcGW3CTNnz5301HUVfw

# --- Resend (transactional email, server-side only) ---
RESEND_API_KEY=re_YOUR_KEY
RESEND_FROM_EMAIL=Town Fitness Point <noreply@YOUR-DOMAIN.com>
ADMIN_NOTIFY_EMAIL=khannmat12@gmail.com

# --- Newsletter unsubscribe tokens ---
# Any long random string. Generate with: openssl rand -base64 32
# Signs the unsubscribe links in newsletter emails (HMAC, 7-day expiry).
NEWSLETTER_SIGNING_SECRET=

# --- Cloudflare Turnstile (optional but recommended) ---
# Empty = disabled. When keys are present, all public forms verify the
# token server-side. TURNSTILE_REQUIRED=true blocks submissions when
# the token is missing/invalid instead of silently skipping.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false

# --- Site ---
# Used for canonical URLs / OG tags. Set to your deployed domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Data mode ---
# "auto" (default): uses Supabase when env vars are present, otherwise
# falls back to clearly-marked placeholder data so the design is
# reviewable without a database. Force with "supabase" or "mock".
DATA_MODE=auto
